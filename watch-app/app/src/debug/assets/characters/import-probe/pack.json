{
  "schema_version": 2,
  "pack": "import-probe",
  "version": "1.0.0",
  "author": "wear-dsh release contributors",
  "attribution": "Debug-only probe art for Role X instrumented render validation; never ships in release.",
  "license": "CC0-1.0",
  "dimensions": { "width": 64, "height": 64 },
  "background": "#000000",
  "actions": [
    { "id": "idle_a", "mode": "neutral_loop", "clips": ["probe_idle_a.xml"], "model_selectable": true, "notes": "Probe idle dim" },
    { "id": "idle_b", "mode": "neutral_loop", "clips": ["probe_idle_b.xml"], "model_selectable": true, "notes": "Probe idle bright" },
    { "id": "idle_c", "mode": "neutral_loop", "clips": ["probe_idle_c.xml"], "model_selectable": true, "notes": "Probe idle outline" },
    { "id": "listen", "mode": "neutral_loop", "clips": ["probe_listen.xml"], "model_selectable": true, "notes": "Probe listen tick" },
    { "id": "talk", "mode": "once", "clips": ["probe_talk.xml"], "model_selectable": true, "notes": "Probe speech bars" },
    { "id": "work_set", "mode": "enter_loop_exit", "clips": ["probe_work_enter.xml", "probe_work_loop.xml", "probe_work_exit.xml"], "model_selectable": true, "notes": "Probe task lifecycle" },
    { "id": "question", "mode": "once", "clips": ["probe_question.xml"], "model_selectable": false, "notes": "State-owned pending-question cue" },
    { "id": "static_hold", "mode": "hold", "clips": ["probe_static.xml"], "model_selectable": false, "notes": "Static reference interstitial" }
  ],
  "clips": {
    "probe_idle_a.xml": { "width": 64, "height": 64, "duration_s": 3.0 },
    "probe_idle_b.xml": { "width": 64, "height": 64, "duration_s": 3.0 },
    "probe_idle_c.xml": { "width": 64, "height": 64, "duration_s": 3.0 },
    "probe_listen.xml": { "width": 64, "height": 64, "duration_s": 3.0 },
    "probe_talk.xml": { "width": 64, "height": 64, "duration_s": 3.0 },
    "probe_work_enter.xml": { "width": 64, "height": 64, "duration_s": 1.5 },
    "probe_work_loop.xml": { "width": 64, "height": 64, "duration_s": 1.0 },
    "probe_work_exit.xml": { "width": 64, "height": 64, "duration_s": 1.5 },
    "probe_question.xml": { "width": 64, "height": 64, "duration_s": 3.0 },
    "probe_static.xml": { "width": 64, "height": 64, "duration_s": 3.0 }
  },
  "roles": {
    "idle": ["idle_a", "idle_b", "idle_c"],
    "listen": ["listen"],
    "talk": ["talk"],
    "work": ["work_set"],
    "question": ["question"],
    "neutral_hold": ["static_hold"]
  },
  "fallback_role": "idle",
  "notes": "Debug-only pack whose vectors exist ONLY as imported asset XML (no compiled res/drawable entry), so the AssetVector inflation path is exercised on-device. Present only in debug builds via src/debug/assets."
}
