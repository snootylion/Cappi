#!/usr/bin/env bash
# Fake `dsh` for deploy --apply success tests: simulates
# `dsh plugin --profile <name> add link:plugins/dsh-live-voice-kokoro` by
# writing the link dependency into the profile package.json and creating the
# profile node_modules symlink. TARGET_DIR (the staged snapshot) and DSH_HOME
# come from the environment. Never touches the network or a real harness.
set -eu
profile=""
while (($# > 0)); do
  case "$1" in
    --profile) profile="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done
if [[ -z "$profile" || -z "${DSH_HOME:-}" || -z "${TARGET_DIR:-}" ]]; then
  printf 'fake-dsh: missing --profile, DSH_HOME, or TARGET_DIR\n' >&2
  exit 2
fi
profile_root="$DSH_HOME/profiles/$profile"
PROFILE_ROOT="$profile_root" TARGET_DIR="$TARGET_DIR" python3 - <<'PY'
import json
import os

profile_root = os.environ["PROFILE_ROOT"]
package_path = os.path.join(profile_root, "package.json")
try:
    with open(package_path, encoding="utf-8") as handle:
        package = json.load(handle)
except FileNotFoundError:
    package = {}
dependencies = package.setdefault("dependencies", {})
dependencies["dsh-live-voice-kokoro"] = "link:plugins/dsh-live-voice-kokoro"
with open(package_path, "w", encoding="utf-8") as handle:
    json.dump(package, handle, indent=2)
    handle.write("\n")
modules = os.path.join(profile_root, "node_modules")
os.makedirs(modules, exist_ok=True)
link = os.path.join(modules, "dsh-live-voice-kokoro")
if os.path.islink(link) or os.path.exists(link):
    os.unlink(link)
os.symlink(os.environ["TARGET_DIR"], link)
PY
