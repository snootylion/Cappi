{
  "schema_version": 2,
  "pack": "dot-default",
  "version": "1.0.0",
  "author": "wear-dsh release contributors",
  "attribution": "Original hand-authored vector frames created for the wear-dsh release; no third-party art.",
  "license": "CC0-1.0",
  "dimensions": { "width": 96, "height": 96 },
  "background": "#000000",
  "actions": [
    { "id": "idle_a", "mode": "neutral_loop", "clips": ["dot_idle_a.xml"], "model_selectable": true, "notes": "Resting dot, centered" },
    { "id": "idle_b", "mode": "neutral_loop", "clips": ["dot_idle_b.xml"], "model_selectable": true, "notes": "Resting dot, small offset" },
    { "id": "idle_c", "mode": "neutral_loop", "clips": ["dot_idle_c.xml"], "model_selectable": true, "notes": "Resting dot, ring accent" },
    { "id": "listen", "mode": "neutral_loop", "clips": ["dot_listen.xml"], "model_selectable": true, "notes": "Ear arc while input is live" },
    { "id": "talk_a", "mode": "once", "clips": ["dot_talk_a.xml"], "model_selectable": true, "notes": "Speech ripple, open" },
    { "id": "talk_b", "mode": "once", "clips": ["dot_talk_b.xml"], "model_selectable": true, "notes": "Speech ripple, wide" },
    { "id": "work_set", "mode": "enter_loop_exit", "clips": ["dot_work_enter.xml", "dot_work_loop.xml", "dot_work_exit.xml"], "model_selectable": true, "notes": "Desk-dot task lifecycle" },
    { "id": "celebrate", "mode": "once", "clips": ["dot_celebrate.xml"], "model_selectable": true, "notes": "Star burst emote" },
    { "id": "question", "mode": "once", "clips": ["dot_question.xml"], "model_selectable": false, "notes": "State-owned pending-question cue; hold final frame" },
    { "id": "static_hold", "mode": "hold", "clips": ["dot_static.xml"], "model_selectable": false, "notes": "Static reference interstitial" }
  ],
  "clips": {
    "dot_idle_a.xml": { "width": 96, "height": 96, "duration_s": 3.0 },
    "dot_idle_b.xml": { "width": 96, "height": 96, "duration_s": 3.0 },
    "dot_idle_c.xml": { "width": 96, "height": 96, "duration_s": 3.0 },
    "dot_listen.xml": { "width": 96, "height": 96, "duration_s": 3.0 },
    "dot_talk_a.xml": { "width": 96, "height": 96, "duration_s": 3.0 },
    "dot_talk_b.xml": { "width": 96, "height": 96, "duration_s": 3.0 },
    "dot_work_enter.xml": { "width": 96, "height": 96, "duration_s": 1.5 },
    "dot_work_loop.xml": { "width": 96, "height": 96, "duration_s": 1.0 },
    "dot_work_exit.xml": { "width": 96, "height": 96, "duration_s": 1.5 },
    "dot_celebrate.xml": { "width": 96, "height": 96, "duration_s": 3.0 },
    "dot_question.xml": { "width": 96, "height": 96, "duration_s": 3.0 },
    "dot_static.xml": { "width": 96, "height": 96, "duration_s": 3.0 }
  },
  "roles": {
    "idle": ["idle_a", "idle_b", "idle_c"],
    "listen": ["listen"],
    "talk": ["talk_a", "talk_b"],
    "work": ["work_set"],
    "celebrate": ["celebrate"],
    "question": ["question"],
    "neutral_hold": ["static_hold"]
  },
  "fallback_role": "idle",
  "notes": "Clean-checkout default. Deliberately omits work_talk so the standing-speech fallback path is exercised in production."
}
